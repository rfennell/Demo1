# Azure Storage Connection String
# Get this from Azure Portal -> Storage Account -> Access Keys
AzureWebJobsStorage=UseDevelopmentStorage=true

# For local development, you can use Azurite (Azure Storage Emulator)
# Install: npm install -g azurite
# Run: azurite-blob --silent --location /tmp/azurite --debug /tmp/azurite/debug.log

# For production, use actual Azure Storage connection string:
# AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=<account-name>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
